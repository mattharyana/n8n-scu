    {
      "id": "218d1f72-6309-5862-ad62-e38997b8483e",
      "name": "Material saved",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{formSubmittedHeader:\"Material indexed\",formSubmittedText:$json.result.output}}];"
      }
    },
    {
      "id": "b1e500ec-e056-5c79-9f34-9e33614dac57",
      "name": "Explain upload error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        650
      ],
      "parameters": {
        "jsCode": "const raw=String($json.error?.message ?? $json.error ?? $json.message ?? '').replace(/\\s*\\[line\\s+\\d+\\]\\s*$/i,'');\nlet message='The file could not be indexed. Please try again. Your previous indexed version is unchanged.';\nif(/^(Use |Upload |Enter |Provide |Choose |Save |Split |Unsupported )/.test(raw)) message=raw;\nelse if(/password|encrypted/i.test(raw)) message='This PDF is password-protected. Remove the password and upload it again.';\nelse if(/no.*text|empty.*text/i.test(raw)) message='No readable text was found. Use a text-based PDF, Markdown, or plain text file.';\nreturn [{json:{formSubmittedHeader:'Upload needs attention',formSubmittedText:message}}];"
      }
    },
    {
      "id": "41a155a0-08e9-5b7c-8ce8-6c6b186d9f2d",
      "name": "Return upload result",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
