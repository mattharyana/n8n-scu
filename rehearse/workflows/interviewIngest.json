        "respondWith": "text",
        "completionTitle": "={{ $json.formSubmittedHeader }}",
        "completionMessage": "={{ $json.formSubmittedText + \"<br><br><a href=/form/interview-materials>Add another material</a> · <a href=http://localhost:5677>Open voice interview</a> · <a href=/webhook/mock-interview-chat/chat>Text chat</a>\" }}",
        "options": {}
      }
    },
    {
      "id": "ea5e9034-1141-5367-b710-5429c9bb7fd6",
      "name": "Guide 17",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -320
      ],
      "parameters": {
        "content": "## 1 · Knowledge base\nOpen the production form at `/form/interview-materials`.\nUpload PDF, DOCX, Markdown or TXT. Use one topic per experience/story. Reusing its ID replaces old vectors only after indexing succeeds.\n\nEmbedding provider: **local**. Local indexing needs no paid API key. Interview/scoring provider: **gemini** (configured in Interview 02).",
        "height": 240,
        "width": 650,
        "color": 5
      }
    }
