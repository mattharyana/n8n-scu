    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const tenure = Number($json['Tenure Months']);\nconst charges = Number($json['Monthly Charges']);\nconst techSupport = $json['Tech Support'];\nconst internet = $json['Internet Service'];\n\nlet points = 0;\nif (tenure < 12) points += 2;\nif (charges > 80) points += 2;\nif (techSupport === 'No') points += 1;\n\nconst risk_level = points >= 4 ? 'high' : points >= 2 ? 'medium' : 'low';\n\nlet primary_driver = 'none';\nif (tenure < 12) primary_driver = 'short tenure';\nelse if (charges > 80) primary_driver = 'high monthly charges';\nelse if (techSupport === 'No') primary_driver = 'no tech support';\nelse if (internet === 'Fiber optic') primary_driver = 'fiber internet';\n\nreturn {\n  json: {\n    customerID: $json['CustomerID'],\n    name: $json['Name'],\n    email: $json['Email'],\n    tenure,\n    Contract: $json['Contract'],\n    MonthlyCharges: charges,\n    InternetService: internet,\n    TechSupport: techSupport,\n    PaymentMethod: $json['Payment Method'],\n    risk_points: points,\n    risk_level,\n    primary_driver\n  }\n};"
      },
